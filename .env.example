# ==========================================
# ClipViral AI - Environment Variables (.env.example)
# ==========================================

# Dedicated Node.js Backend API (Live Render URL)
NEXT_PUBLIC_BACKEND_URL="https://clipviral-backend-live.onrender.com"
NEXT_PUBLIC_API_URL="https://clipviral-backend-live.onrender.com"

# 1. DATABASE (MongoDB Atlas or Local MongoDB)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clipviral_ai?retryWrites=true&w=majority"

# 2. NEXTAUTH AUTHENTICATION (Set to your live domain in production)
NEXTAUTH_URL="https://clipviral-frontend.vercel.app"
NEXTAUTH_SECRET="your_nextauth_secret_key_minimum_32_characters"

# 3. GOOGLE OAUTH PROVIDER
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. SOCIAL MEDIA INTEGRATION (TikTok & Instagram OAuth)
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
INSTAGRAM_CLIENT_ID="your-instagram-app-id"
INSTAGRAM_CLIENT_SECRET="your-instagram-app-secret"

# 5. EMAIL / MAGIC LINK PROVIDER (SMTP)
EMAIL_SERVER_HOST="smtp.sendgrid.net"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="your-smtp-api-key"
EMAIL_FROM="ClipViral AI <noreply@clipviral.ai>"

# 6. STRIPE PAYMENTS & SUBSCRIPTIONS
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
STRIPE_PRICE_STARTER_MONTHLY="price_starter_monthly_here"
STRIPE_PRICE_STARTER_YEARLY="price_starter_yearly_here"
STRIPE_PRICE_CREATOR_MONTHLY="price_creator_monthly_here"
STRIPE_PRICE_CREATOR_YEARLY="price_creator_yearly_here"
STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly_here"
STRIPE_PRICE_PRO_YEARLY="price_pro_yearly_here"

# 7. CLOUDINARY CLOUD STORAGE (Direct Client Video Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"

# 8. AI TRANSCRIPTION & SPEECH-TO-TEXT (OpenAI Whisper)
OPENAI_API_KEY="sk-proj-your_openai_api_key_for_whisper"
